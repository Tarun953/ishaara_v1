# Copy to .env.prod (git-ignored). Loaded after .env when ISHAARA_ENV=prod, by
# `ISHAARA_ENV=prod uv run ishaara process ...` and by scripts/deploy.sh.
# No secrets belong here: GEMINI_API_KEY and YOUTUBE_API_KEY stay in .env locally and in
# Secret Manager on Cloud Run. Production refuses AUTH_BYPASS_UID, memory and local storage.
ENVIRONMENT=production
DATABASE_BACKEND=firestore
STORAGE_BACKEND=gcs
AUDIO_BUCKET=<project-id>-narration-audio
TRANSCRIPT_BUCKET=<project-id>-transcripts
ALLOWED_ORIGINS=https://<project-id>.web.app,https://<project-id>.firebaseapp.com
# Speech requests per minute; the free-tier Gemini key allows 3 (0 = unlimited, for a billed key)
TTS_REQUESTS_PER_MINUTE=3
