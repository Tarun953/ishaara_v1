# Reference for every setting and its default. Real values live in git-ignored files:
#   .env         shared by every environment (API keys, models, limits)
#   .env.local   local development (copy from .env.local.example), the default
#   .env.prod    production (copy from .env.prod.example), selected with ISHAARA_ENV=prod
# Files are layered .env then .env.<ISHAARA_ENV>; real environment variables beat both.
ENVIRONMENT=local
GEMINI_API_KEY=
YOUTUBE_API_KEY=
GCP_PROJECT_ID=
AUDIO_BUCKET=
TRANSCRIPT_BUCKET=
ANALYSIS_MODEL=gemini-3.8-flash
TEXT_MODEL=gemini-3.5-flash-lite
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
PIPELINE_VERSION=2
MAX_VIDEO_MINUTES=45
CLIP_WINDOW_SECONDS=600
CLIP_OVERLAP_SECONDS=10
ANALYSIS_CONCURRENCY=3
TTS_CONCURRENCY=4
MIN_CONFIDENCE=0.5
MIN_CUE_GAP_SECONDS=6
DAILY_VIDEO_LIMIT=10
DAILY_QUESTION_LIMIT=50
MAX_REQUEST_BODY_BYTES=16384
ALLOWED_ORIGINS=http://localhost:5173
AUTH_BYPASS_UID=
# memory (local, nothing persisted) | firestore | supabase
DATABASE_BACKEND=memory
# Supabase session-pooler connection string (IPv4); only for DATABASE_BACKEND=supabase
SUPABASE_DB_URL=
# Used only by the Supabase contract tests, which work in a throwaway schema
SUPABASE_TEST_DB_URL=
# local (files under LOCAL_STORAGE_DIR, served at /media) | gcs | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local_storage
PUBLIC_BASE_URL=http://localhost:8000
# Supabase Storage (STORAGE_BACKEND=supabase): project URL and service-role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
LOG_LEVEL=INFO
