ENVIRONMENT=local
GEMINI_API_KEY=
YOUTUBE_API_KEY=
GCP_PROJECT_ID=
AUDIO_BUCKET=
TRANSCRIPT_BUCKET=
ANALYSIS_MODEL=gemini-3.8-flash
TEXT_MODEL=gemini-3.5-flash-lite
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
PIPELINE_VERSION=1
MAX_VIDEO_MINUTES=45
CLIP_WINDOW_SECONDS=600
CLIP_OVERLAP_SECONDS=10
ANALYSIS_CONCURRENCY=3
TTS_CONCURRENCY=4
MIN_CONFIDENCE=0.5
MIN_CUE_GAP_SECONDS=6
DAILY_VIDEO_LIMIT=10
DAILY_QUESTION_LIMIT=50
ALLOWED_ORIGINS=http://localhost:5173
AUTH_BYPASS_UID=
# memory (local, nothing persisted) | firestore | supabase
DATABASE_BACKEND=memory
# Supabase session-pooler connection string (IPv4); only for DATABASE_BACKEND=supabase
SUPABASE_DB_URL=
# Used only by the Supabase contract tests, which work in a throwaway schema
SUPABASE_TEST_DB_URL=
LOG_LEVEL=INFO
