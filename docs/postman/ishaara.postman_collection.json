{
  "info": {
    "name": "Ishaara API",
    "description": "Requests for every implemented Ishaara endpoint. See docs/API.md. Set `idToken` (or leave empty when the server runs with AUTH_BYPASS_UID) and `baseUrl`, then run Videos in order: submit, then poll.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{idToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "videoKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /healthz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Liveness check. No authentication.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Videos",
      "item": [
        {
          "name": "POST /v1/videos - submit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/videos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "videos"
              ]
            },
            "description": "Submit a lecture. 202 = queued/processing/restarted, 200 = already ready. Saves `videoKey` for the next requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"youtube_url\": \"{{youtubeUrl}}\",\n  \"narration_language\": \"{{narrationLanguage}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 202', () => pm.expect([200, 202]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "pm.test('has video_key and status', () => { pm.expect(body.video_key).to.be.a('string'); pm.expect(body.status).to.be.oneOf(['queued','processing','ready']); });",
                  "pm.collectionVariables.set('videoKey', body.video_key);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/videos/{video_key} - poll status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/videos/{{videoKey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "videos",
                "{{videoKey}}"
              ]
            },
            "description": "Poll every ~3 seconds until `status` is `ready` or `failed`. Re-send this request to refresh."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('progress is 0-100', () => pm.expect(body.progress_percent).to.be.within(0, 100));",
                  "console.log(body.status, body.stage, body.progress_percent + '%');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/me/videos - history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me/videos?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me",
                "videos"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Newest first. `limit` is 1 to 100 (default 20)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with a videos array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().videos).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error cases",
      "description": "Each request is expected to fail in the documented way; the tests assert the problem+json shape.",
      "item": [
        {
          "name": "No token -> 401 invalid_token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me/videos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me",
                "videos"
              ]
            },
            "description": "Sends no Authorization header. Skip this when AUTH_BYPASS_UID is set on the server.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 invalid_token', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().code).to.eql('invalid_token'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Not a YouTube link -> 400 invalid_youtube_url",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/videos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "videos"
              ]
            },
            "description": "A non-YouTube host is rejected before any work happens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"youtube_url\": \"https://example.com/watch?v=dQw4w9WgXcQ\",\n  \"narration_language\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 invalid_youtube_url', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().code).to.eql('invalid_youtube_url'); });",
                  "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing field -> 422 invalid_request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/videos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "videos"
              ]
            },
            "description": "`narration_language` is required.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"youtube_url\": \"{{youtubeUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 invalid_request', () => { pm.response.to.have.status(422); pm.expect(pm.response.json().code).to.eql('invalid_request'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown video -> 404 video_not_found",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/videos/doesnotexist_en_v2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "videos",
                "doesnotexist_en_v2"
              ]
            },
            "description": "No stored video with that key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 video_not_found', () => { pm.response.to.have.status(404); pm.expect(pm.response.json().code).to.eql('video_not_found'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}