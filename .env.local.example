# Copy to .env.local (git-ignored). Loaded after .env when ISHAARA_ENV is unset or "local".
# Local development against Supabase, acting as a fixed user with no Firebase token.
ENVIRONMENT=local
AUTH_BYPASS_UID=dev-user
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_BACKEND=supabase
# Supabase session-pooler connection string (IPv4)
SUPABASE_DB_URL=
# Used only by the Supabase contract tests (a throwaway schema is created and dropped)
SUPABASE_TEST_DB_URL=
STORAGE_BACKEND=supabase
SUPABASE_URL=
# The SECRET key, never the publishable one
SUPABASE_SERVICE_KEY=
AUDIO_BUCKET=
TRANSCRIPT_BUCKET=
